# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment variables — contains API keys, never commit
.env

# IDE
.idea/
.vscode/
*.swp

# Local config — per-machine settings, not shared
.claude/

# OS
.DS_Store
Thumbs.db

# Sensitive data — contains private information, never commit or share
data/sensitive data/

# Large generated data — regenerable from pipeline, not tracked in git
output/

# Train/test split JSONL files (regenerable from pipeline)
data/06_train_test_split/

# Model weight files — too large for git (single file > 1GB), download separately
*.safetensors
*.pt
*.pth
*.bin
rng_state.pth
scheduler.pt
optimizer.pt
training_args.bin

# Full model directories — downloaded model bodies, not tracked in git
gemma/
checkpoint/

# TTS audio data — large WAV files (~200MB), reference audio & game voice lines, not tracked
TTS/data/

# Downloaded LLM models — large files (several GB), download from HuggingFace separately
qwen/